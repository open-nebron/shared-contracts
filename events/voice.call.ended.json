{
  "$id": "voice.call.ended",
  "type": "object",
  "required": ["callId", "endedBy", "reason", "at"],
  "properties": {
    "callId":         { "type": "string" },
    "callerId":       { "type": ["string", "null"] },
    "calleeId":       { "type": ["string", "null"] },
    "conversationId": { "type": ["string", "null"] },
    "endedBy":        { "type": ["string", "null"] },
    "reason":         { "type": "string", "enum": ["hangup", "reject", "missed", "cancelled", "error", "livekit_closed", "host_ended", "all_left"] },
    "at":             { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}

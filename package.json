{
  "name": "@nebron/contracts",
  "version": "1.6.0",
  "description": "Single source of truth for API schemas and event contracts across Nebron polyrepo",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "openapi",
    "events"
  ],
  "scripts": {
    "build": "npm run generate && tsc",
    "generate": "./scripts/generate.sh",
    "sync": "./scripts/sync.sh",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.11.2",
    "json-schema-to-typescript": "^16.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
